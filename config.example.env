# TZW Skills personal settings — template.
# Copy to config.local.env (git-ignored) and fill in your own values:
#   cp config.example.env config.local.env
# Format: KEY=value, one per line. "~" expands to your home folder.
# A real environment variable with the same name overrides the file.
# To keep the file elsewhere, set NIU_SKILLS_CONFIG=/path/to/file.

# work-log-sync / work-log-recall: root folder of the daily Markdown work log
WORK_LOG_DIR=~/Projects/YourCompany-Logs

# work-task-reminder: Apple Reminders list per category
REMINDER_LIST_WORK=Work
REMINDER_LIST_STUDY=Study
REMINDER_LIST_ERRANDS=Errands

# computer-health-check: folders that hold your own projects (space-separated)
PROJECT_DIRS=~/Code ~/Projects ~/Documents
